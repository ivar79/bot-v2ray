{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v2ray-aggregator",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database binding
  // After running: npx wrangler d1 create v2ray-aggregator
  // Uncomment and paste the database_id:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "v2ray-aggregator",
  //     "database_id": "YOUR_DATABASE_ID_HERE"
  //   }
  // ],

  // Secrets (set via wrangler secret put):
  // TELEGRAM_BOT_TOKEN
  // TELEGRAM_WEBHOOK_SECRET
  // GITHUB_TOKEN
  // ADMIN_USER_IDS

  // Optional: Cron triggers for periodic tasks
  // "triggers": {
  //   "crons": ["0 0 * * *"]
  // }
}
